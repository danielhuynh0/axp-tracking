{
  "name": "axp-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --minify --outfile=dist/handler.js",
    "dev": "esbuild dev/server.ts --bundle --platform=node --outfile=.dev/server.js && node .dev/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
