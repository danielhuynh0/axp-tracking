{
  "name": "axp-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "npm run dev --workspace @axp/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test apps/api/test/*.test.ts packages/contracts/test/*.test.ts scripts/*.test.ts",
    "build": "npm run build:api && npm run build --workspace @axp/web",
    "build:api": "node scripts/build-api.mjs && node scripts/smoke-api.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.8.0"
  }
}
